{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Live Server",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "5500"],
      "options": {
        "cwd": "${workspaceFolder}/press"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Format HTML",
      "type": "shell",
      "command": "prettier",
      "args": ["--write", "**/*.html"],
      "options": {
        "cwd": "${workspaceFolder}/press"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Format CSS",
      "type": "shell",
      "command": "prettier",
      "args": ["--write", "**/*.css"],
      "options": {
        "cwd": "${workspaceFolder}/press"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Format JavaScript",
      "type": "shell",
      "command": "prettier",
      "args": ["--write", "**/*.js"],
      "options": {
        "cwd": "${workspaceFolder}/press"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Format All Files",
      "dependsOrder": "sequence",
      "dependsOn": ["Format HTML", "Format CSS", "Format JavaScript"]
    }
  ]
}